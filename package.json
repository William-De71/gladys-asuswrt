{
  "name": "gladys-asuswrt",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for ASUS routers (ASUSWRT, Asuswrt-Merlin): system health, internet link, Wi-Fi radios, network presence, scenes and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-asuswrt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-asuswrt.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "asus",
    "asuswrt",
    "asuswrt-merlin",
    "router",
    "presence",
    "home-automation"
  ]
}
