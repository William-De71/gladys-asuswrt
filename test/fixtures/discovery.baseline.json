{
  "devices": {
    "router": {
      "external_id": "ext:asuswrt:router:main",
      "should_poll": false,
      "params": ["MAC", "FIRMWARE"],
      "features": [
        {
          "external_id": "ext:asuswrt:router:main:cpu",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:memory",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:temperature_cpu",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 150,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:temperature_2g",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 150,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:temperature_5g",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 150,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:temperature_5g2",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 150,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:temperature_6g",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 150,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:uptime",
          "category": "duration",
          "type": "decimal",
          "unit": "days",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:download",
          "category": "datarate",
          "type": "rate",
          "unit": "megabits-per-second",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:upload",
          "category": "datarate",
          "type": "rate",
          "unit": "megabits-per-second",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:internet",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:wan_ip",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:clients",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:asuswrt:router:main:firmware",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "radio": {
      "external_id": "ext:asuswrt:radio:wl1",
      "should_poll": false,
      "params": ["WIRELESS_UNIT"],
      "features": [
        {
          "external_id": "ext:asuswrt:radio:wl1:enabled",
          "category": "switch",
          "type": "binary",
          "min": 0,
          "max": 1,
          "read_only": false,
          "has_feedback": true
        }
      ]
    },
    "client": {
      "external_id": "ext:asuswrt:client:a483e7123456",
      "should_poll": false,
      "params": ["MAC", "VENDOR"],
      "features": [
        {
          "external_id": "ext:asuswrt:client:a483e7123456:presence",
          "category": "presence-sensor",
          "type": "push",
          "min": 0,
          "max": 1,
          "read_only": true,
          "has_feedback": false
        }
      ]
    }
  },
  "manifest": {
    "actions": ["test_connection", "forget_network_devices"],
