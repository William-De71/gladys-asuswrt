          },
          {
            "key": "name",
            "type": "string"
          },
          {
            "key": "vendor",
            "type": "string"
          },
          {
            "key": "medium",
            "type": "string"
          },
          {
            "key": "connection",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "router_rebooted",
        "fields": [],
