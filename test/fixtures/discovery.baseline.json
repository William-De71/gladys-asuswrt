      {
        "key": "intro",
        "type": "section"
      },
      {
        "key": "url",
        "type": "string"
      },
      {
        "key": "username",
        "type": "string"
      },
      {
        "key": "password",
        "type": "secret"
      },
      {
        "key": "verify_tls",
        "type": "boolean"
      },
      {
        "key": "options_intro",
        "type": "section"
      },
      {
        "key": "poll_interval",
